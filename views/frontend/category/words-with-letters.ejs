<!-- Header and other imports -->
<%- (include('../../frontend/head/head.ejs')) %>
<body class="font-custom">
    <!-- Header -->
    <%- (include('../../frontend/head/header.ejs')) %>
    
    <!-- Content section -->
    <div class="content-block mb-5">
        <div class="container pt-5">
            <div class="flex justify-center">
                <div class="w-full md:w-12/12">
                    <div class="border border-[#007BFF4D] rounded-[20px] md:p-[40px] p-[30px] my-16">
                        <h1 class="mb-4 text-3xl font-semibold md:text-4xl text-center">Words By Letters</h1>
                        <ul class="space-y-2 list-disc">
                            <% // Render single letters A-Z %>
                            <% if (page == 1) { %>
                                <% for (let i = 0; i < 26; i++) { %>
                                <% const letter = String.fromCharCode(65 + i); %>
                                <li><a href="/words-with/<%= letter.toLowerCase() %>" class="text-base font-normal text-blue-500 underline hover-text-blue">Words with <%= letter %></a></li>
                            <% } %>
                            <% } %>

                            <% letters.forEach(item => { %>
                                <% if (item.char1) { %>
                                    <% if (item.char2) { %>
                                        <li><a href="/words-with/<%= item.char1.toLowerCase() %>/and/<%= item.char2.toLowerCase() %>" class="text-base font-normal text-blue-500 underline hover-text-blue">Words with <%= item.char1 %> and <%= item.char2 %></a></li>
                                    <% } else if (item.without) { %>
                                        <li><a href="/words-with/<%= item.char1.toLowerCase() %>/without/<%= item.char2.toLowerCase() %>" class="text-base font-normal text-blue-500 underline hover-text-blue">Words with <%= item.char1 %> without <%= item.char2 %></a></li>
                                    <% } else { %>
                                        <li><a href="/words-with/<%= item.char1.toLowerCase() %>" class="text-base font-normal text-blue-500 underline hover-text-blue">Words with <%= item.char1 %></a></li>
                                    <% } %>
                                <% } %>
                            <% }) %>
                        </ul>
                    </div>

                    <!-- Pagination -->
<nav class="flex items-center justify-center mb-10 gap-x-1 pagination">
    <% if (page > 1) { %>
        <a href="/category/words-with-letters?page=<%= page - 1 %>" class="pagination-link">&laquo; Previous</a>
    <% } %>
    
    <div class="flex items-center gap-x-1">
        <% let startPage = Math.max(1, page - 2); %>
        <% let endPage = Math.min(totalPages, page + 2); %>

        <% if (startPage > 1) { %>
            <a href="/category/words-with-letters?page=1" class="pagination-link">1</a>
            <% if (startPage > 2) { %>
                <span class="pagination-ellipsis">...</span>
            <% } %>
        <% } %>

        <% for (let i = startPage; i <= endPage; i++) { %>
            <a href="/category/words-with-letters?page=<%= i %>" class="pagination-link <%= page === i ? 'active' : '' %>"><%= i %></a>
        <% } %>

        <% if (endPage < totalPages) { %>
            <% if (endPage < totalPages - 1) { %>
                <span class="pagination-ellipsis">...</span>
            <% } %>
            <a href="/category/words-with-letters?page=<%= totalPages %>" class="pagination-link"><%= totalPages %></a>
        <% } %>
    </div>
    
    <% if (page < totalPages) { %>
        <a href="/category/words-with-letters?page=<%= page + 1 %>" class="pagination-link">Next &raquo;</a>
    <% } %>
</nav>
<!-- End Pagination -->


                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- (include('../../frontend/footer/footer.ejs')) %>

    <!-- Scripts -->
    <%- (include('../../frontend/script/script.ejs')) %>
